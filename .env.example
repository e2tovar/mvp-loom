# Conexión a Neo4j (usada por backend/graph/client.py)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=loom-dev-password
# Base de datos a usar (opcional; vacío = default del servidor, normalmente "neo4j")
# NEO4J_DATABASE=neo4j

# Longitud por defecto del fragmento identificador de escena en el resumen estructural
LOOM_SNIPPET_LEN=120

# ── LLM gateway (backend/llm/) ────────────────────────────────────────────────
# Perfil 1: OpenCode Go (OpenAI-compatible, default de desarrollo)
# LOOM_LLM_MODEL=openai/kimi-k2      # nombre del modelo en formato LiteLLM
# LOOM_LLM_API_BASE=https://…        # base URL del endpoint compatible-OpenAI
# LOOM_LLM_API_KEY=…                 # API key del proveedor

# Perfil 2: Azure OpenAI (contraste de calidad)
# AZURE_API_KEY=…
# AZURE_API_BASE=https://…azure.com/
# AZURE_API_VERSION=2024-08-01-preview

# ── Eval harness ──────────────────────────────────────────────────────────────
# Raíz de las cachés de respuestas LLM. Por defecto .cache/ (sin versionar).
# El eval apunta aquí para usar las respuestas congeladas del repo:
# LOOM_CACHE_DIR=eval/fixtures/llm-cache
#
# Con LOOM_EVAL_STRICT=1 los gates de eval FALLAN en vez de omitirse cuando el
# grafo no está sembrado. El CI lo activa; en local déjalo apagado y usa
# `make seed` antes de `make gates`.
# LOOM_EVAL_STRICT=1

# ── Observabilidad (opt-in, ADR-0003) ─────────────────────────────────────────
# Self-hosted Langfuse (docker-compose.langfuse.yml). Vacías = observabilidad
# deshabilitada por completo (fail-open, ninguna extracción depende de esto).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
#
# El eval harness fija LOOM_DISABLE_LANGFUSE=1 por código (eval/seed.py), no
# hace falta fijarlo aquí salvo que quieras forzarlo también fuera del eval.
# LOOM_DISABLE_LANGFUSE=1